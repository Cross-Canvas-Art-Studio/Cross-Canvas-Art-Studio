
# Runtime data — SQLite user DB, uploaded images, saved projects, logs.
# *.db also covers the users_test.db that pytest writes at the repo root.
data/
*.db

# Local tool config and scan output.
.trivyignore
.trivy-scans/

*.gitignore

# Secrets / API keys / credentials — never commit these.
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
config/secrets/*
.npmrc
*.log

# Python
__pycache__/
.venv/
venv/
.pytest_cache/

# IDEs and Editors
.vscode/
tools/